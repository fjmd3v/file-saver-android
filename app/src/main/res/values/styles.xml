<?xml version="1.0" encoding="utf-8"?>
<resources>
	<!-- Rounded Miuix-style buttons -->
	<style name="Widget.FileSaver.Button" parent="Widget.AppCompat.Button">
		<item name="android:background">@drawable/fs_button_primary</item>
		<item name="android:minHeight">@dimen/fs_button_height</item>
		<item name="android:paddingStart">24dp</item>
		<item name="android:paddingEnd">24dp</item>
		<item name="android:textAllCaps">false</item>
		<item name="android:textSize">@dimen/miuix_dialog_button_text</item>
		<item name="android:fontFamily">sans-serif-medium</item>
		<item name="android:textColor">@color/fs_button_primary_text</item>
		<item name="android:stateListAnimator">@null</item>
		<item name="android:elevation">0dp</item>
	</style>

	<style name="Widget.FileSaver.Button.Secondary">
		<item name="android:background">@drawable/fs_button_secondary</item>
		<item name="android:textColor">@color/miuix_dialog_button_text_1</item>
	</style>

	<!-- Tonal secondary action (accent 3 with dynamic colors) -->
	<style name="Widget.FileSaver.Button.Tonal">
		<item name="android:background">@drawable/fs_button_tonal</item>
		<item name="android:textColor">@color/fs_button_tonal_text</item>
		<item name="android:paddingStart">20dp</item>
		<item name="android:paddingEnd">24dp</item>
		<item name="android:drawablePadding">8dp</item>
		<item name="drawableTint">@color/fs_button_tonal_text</item>
	</style>

	<style name="TextAppearance.FileSaver.Body" parent="">
		<item name="android:textSize">15sp</item>
		<item name="android:textColor">@color/fs_text_primary</item>
		<item name="android:lineSpacingMultiplier">1.2</item>
	</style>
</resources>
