	<!-- Support Dialog -->
	<string name="support_header">Thank You!</string>
	<string name="support_body1">As &appname; has grown and evolved, I\'ve realised that I\'m only
		interested in saving images, and so I\'ve released a new app that focuses exclusively
		on images.
	</string>
	<string name="support_body2">If this is of interest to you, or you wish to support &author; and
		future development, please consider purchasing the new app.
	</string>
	<string name="support_link">
		<a href="https://play.google.com/store/apps/details?id=link.standen.michael.imagesaver">
			Image Saver on Google Play
		</a>
	</string>
