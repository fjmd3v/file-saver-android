<?xml version="1.0" encoding="utf-8"?>
<!-- Rounded primary button (Miuix dialog button shape) with native ripple feedback -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
	android:color="#33FFFFFF">
	<item>
		<selector>
			<item android:state_enabled="false">
				<shape android:shape="rectangle">
					<corners android:radius="@dimen/fs_button_radius" />
					<solid android:color="@color/fs_disabled_container" />
				</shape>
			</item>
			<item>
				<shape android:shape="rectangle">
					<corners android:radius="@dimen/fs_button_radius" />
					<solid android:color="?attr/fsColorAccent" />
				</shape>
			</item>
		</selector>
	</item>
</ripple>
