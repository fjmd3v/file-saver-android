<?xml version="1.0" encoding="utf-8"?>
<!-- Empty / informational state card -->
<LinearLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:layout_width="match_parent"
	android:layout_height="wrap_content"
	android:layout_marginStart="@dimen/miuix_prefs_margin"
	android:layout_marginTop="@dimen/miuix_module_margin_top"
	android:layout_marginEnd="@dimen/miuix_prefs_margin"
	android:background="@drawable/fs_card_background"
	android:gravity="center_horizontal"
	android:orientation="vertical"
	android:paddingStart="24dp"
	android:paddingTop="32dp"
	android:paddingEnd="24dp"
	android:paddingBottom="24dp">

	<FrameLayout
		android:layout_width="@dimen/fs_empty_illustration"
		android:layout_height="@dimen/fs_empty_illustration"
		android:background="@drawable/fs_icon_tile"
		android:importantForAccessibility="no">

		<ImageView
			android:id="@+id/message_icon"
			android:layout_width="48dp"
			android:layout_height="48dp"
			android:layout_gravity="center"
			android:importantForAccessibility="no"
			app:tint="?attr/fsColorOnAccentContainer"
			tools:srcCompat="@drawable/fs_ic_folder_add" />
	</FrameLayout>

	<TextView
		android:id="@+id/message_title"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_marginTop="20dp"
		android:fontFamily="sans-serif-medium"
		android:gravity="center"
		android:textColor="@color/fs_text_primary"
		android:textSize="20sp"
		tools:text="@string/folder_list_empty_title" />

	<TextView
		android:id="@+id/message_body"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_marginTop="8dp"
		android:gravity="center"
		android:lineSpacingMultiplier="1.15"
		android:textColor="@color/fs_text_secondary"
		android:textSize="15sp"
		tools:text="@string/folder_list_empty_body" />

	<Button
		android:id="@+id/message_action"
		style="@style/Widget.FileSaver.Button"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:layout_marginTop="24dp"
		android:minWidth="200dp"
		tools:text="@string/folder_list_add_destination" />
</LinearLayout>
