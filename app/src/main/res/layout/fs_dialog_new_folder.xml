<?xml version="1.0" encoding="utf-8"?>
<!-- Content of the "New folder" Miuix dialog -->
<LinearLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	android:layout_width="match_parent"
	android:layout_height="wrap_content"
	android:orientation="vertical">

	<com.hchen.himiuix.widget.MiuixEditText
		android:id="@+id/new_folder_name"
		android:layout_width="match_parent"
		android:layout_height="wrap_content" />

	<TextView
		android:id="@+id/new_folder_error"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_marginTop="8dp"
		android:accessibilityLiveRegion="polite"
		android:paddingStart="4dp"
		android:paddingEnd="4dp"
		android:textColor="@color/fs_danger"
		android:textSize="@dimen/miuix_summary"
		android:visibility="gone" />
</LinearLayout>
