<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:tools="http://schemas.android.com/tools"
	android:id="@+id/container"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	tools:ignore="MergeRootFrame"
	tools:context="link.standen.michael.phonesaver.activity.FolderSelectActivity">

	<com.hchen.himiuix.MiuixAppBar
		android:id="@+id/appbar"
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		android:title="@string/title_activity_folder_select">

		<androidx.fragment.app.FragmentContainerView
			android:id="@+id/fragment_container"
			android:name="link.standen.michael.phonesaver.ui.MiuixListFragment"
			android:layout_width="match_parent"
			android:layout_height="match_parent" />
	</com.hchen.himiuix.MiuixAppBar>

	<!-- Bottom action bar (replaces the old BottomNavigationView "Here" / "Read Only") -->
	<FrameLayout
		android:id="@+id/navigation"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_gravity="bottom"
		android:background="@color/fs_nav_bar_scrim"
		android:paddingStart="@dimen/miuix_dialog_padding"
		android:paddingTop="@dimen/miuix_basic_margin"
		android:paddingEnd="@dimen/miuix_dialog_padding"
		android:paddingBottom="@dimen/miuix_basic_margin">

		<Button
			android:id="@+id/navigation_here"
			style="@style/Widget.FileSaver.Button"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:text="@string/folder_select_here" />

		<Button
			android:id="@+id/navigation_read_only"
			style="@style/Widget.FileSaver.Button"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:enabled="false"
			android:text="@string/folder_select_read_only"
			android:visibility="gone" />
	</FrameLayout>
</FrameLayout>
