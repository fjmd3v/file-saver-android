<?xml version="1.0" encoding="utf-8"?>
<com.hchen.himiuix.springback.SpringBackLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	app:linkageAppBar="true"
	app:scrollableView="@id/scroll">

	<androidx.core.widget.NestedScrollView
		android:id="@+id/scroll"
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		android:overScrollMode="never">

		<!-- Pads the content below the app bar and above the navigation bar -->
		<com.hchen.himiuix.fill.MiuixFillView
			android:layout_width="match_parent"
			android:layout_height="wrap_content">

			<!-- Header card -->
			<LinearLayout
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginStart="@dimen/miuix_prefs_margin"
				android:layout_marginTop="@dimen/miuix_basic_margin"
				android:layout_marginEnd="@dimen/miuix_prefs_margin"
				android:background="@drawable/fs_card_background"
				android:gravity="center_horizontal"
				android:orientation="vertical"
				android:padding="24dp">

				<ImageView
					android:layout_width="@dimen/fs_logo_size"
					android:layout_height="@dimen/fs_logo_size"
					android:contentDescription="@string/logo_description"
					android:src="@mipmap/ic_launcher" />

				<TextView
					android:id="@+id/credits_app_name"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:layout_marginTop="12dp"
					android:fontFamily="sans-serif-medium"
					android:text="@string/app_name"
					android:textAlignment="center"
					android:textColor="@color/fs_text_primary"
					android:textSize="22sp" />

				<TextView
					android:id="@+id/credits_version"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:layout_marginTop="4dp"
					android:textAlignment="center"
					android:textColor="@color/fs_text_secondary"
					android:textSize="@dimen/miuix_summary" />

				<TextView
					android:id="@+id/credits_creator"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:layout_marginTop="8dp"
					android:minHeight="@dimen/fs_touch_target"
					android:gravity="center"
					android:text="@string/credits_creator"
					android:textAppearance="@style/TextAppearance.FileSaver.Body" />
			</LinearLayout>

			<TextView
				style="@style/MiuixDividerStyle"
				android:id="@+id/credits_section_about"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:text="@string/credits_section_about" />

			<LinearLayout
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginStart="@dimen/miuix_prefs_margin"
				android:layout_marginEnd="@dimen/miuix_prefs_margin"
				android:background="@drawable/fs_card_background"
				android:orientation="vertical"
				android:padding="@dimen/fs_row_padding_horizontal">

				<TextView
					android:id="@+id/credits_content1"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:text="@string/credits_content1"
					android:textAppearance="@style/TextAppearance.FileSaver.Body" />

				<TextView
					android:id="@+id/credits_content2"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:layout_marginTop="12dp"
					android:text="@string/credits_content2"
					android:textAppearance="@style/TextAppearance.FileSaver.Body" />

				<TextView
					android:id="@+id/credits_content3"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:layout_marginTop="12dp"
					android:text="@string/credits_content3"
					android:textAppearance="@style/TextAppearance.FileSaver.Body" />

				<TextView
					android:id="@+id/credits_content_translator"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:layout_marginTop="12dp"
					android:text="@string/credits_content_translator"
					android:textAppearance="@style/TextAppearance.FileSaver.Body" />
			</LinearLayout>

			<TextView
				style="@style/MiuixDividerStyle"
				android:id="@+id/credits_section_licenses"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:text="@string/credits_section_licenses" />

			<LinearLayout
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginStart="@dimen/miuix_prefs_margin"
				android:layout_marginEnd="@dimen/miuix_prefs_margin"
				android:layout_marginBottom="@dimen/miuix_basic_margin"
				android:background="@drawable/fs_card_background"
				android:orientation="vertical"
				android:padding="@dimen/fs_row_padding_horizontal">

				<TextView
					style="@style/MiuixTitleStyle"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:ellipsize="end"
					android:focusable="false"
					android:text="@string/credits_miuix_title" />

				<TextView
					android:id="@+id/credits_miuix_body"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:layout_marginTop="4dp"
					android:text="@string/credits_miuix_body"
					android:textAppearance="@style/TextAppearance.FileSaver.Body" />

				<TextView
					style="@style/MiuixTitleStyle"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:layout_marginTop="16dp"
					android:ellipsize="end"
					android:focusable="false"
					android:text="@string/credits_libraries_title" />

				<TextView
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:layout_marginTop="4dp"
					android:text="@string/credits_libraries_body"
					android:textAppearance="@style/TextAppearance.FileSaver.Body" />
			</LinearLayout>
		</com.hchen.himiuix.fill.MiuixFillView>
	</androidx.core.widget.NestedScrollView>
</com.hchen.himiuix.springback.SpringBackLayout>
